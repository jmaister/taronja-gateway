# Copy this file to .env, fill in what you want to test, then:
#   docker compose up --build
#
# Every value here is optional — the demo runs fully without any of them
# (Basic auth, at admin/admin123, always works; Google/GitHub login buttons
# just don't appear on the login page until their client ID+secret are set).

# --- Google OAuth2 login ---------------------------------------------
# 1. https://console.cloud.google.com/apis/credentials
#    -> "+ Create Credentials" -> "OAuth client ID" -> Application type: "Web application"
# 2. Authorized redirect URI (must match exactly):
#      http://localhost:8080/_/auth/google/callback
# 3. Paste the values Google gives you below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth2 login (optional, same idea) ------------------------
# 1. https://github.com/settings/developers -> "New OAuth App"
# 2. Authorization callback URL (must match exactly):
#      http://localhost:8080/_/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
